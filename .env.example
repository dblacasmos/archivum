DATABASE_URL=postgresql+psycopg://archivum:archivum@localhost:5433/archivum

JWT_SECRET_KEY=your_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_ENABLED=true

RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

RATE_LIMIT_QUERY_MAX_REQUESTS=20
RATE_LIMIT_QUERY_WINDOW_SECONDS=60

RATE_LIMIT_UPLOAD_MAX_REQUESTS=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60

UPLOAD_DIR=./storage/documents
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.md,.doc,.docx

OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_EMBEDDINGS_DIMENSIONS=1536
OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
OPENAI_EMBEDDINGS_TIMEOUT_SECONDS=60
OPENAI_EMBEDDINGS_BATCH_SIZE=32